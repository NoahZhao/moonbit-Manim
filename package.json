{
  "name": "moonmanim-build-tools",
  "private": true,
  "license": "MIT",
  "description": "Build-time TeX asset compilation and offline video export for the MoonBit engine",
  "scripts": {
    "tex": "node scripts/compile-tex.cjs",
    "lessons": "node scripts/render-videos.cjs --lessons",
    "lesson-stills": "node scripts/render-videos.cjs --lessons --stills",
    "demos": "node scripts/render-videos.cjs",
    "narration": "node scripts/build-narration.cjs",
    "dynamics": "node scripts/render-videos.cjs --dynamics",
    "cnn": "node scripts/render-videos.cjs --cnn",
    "dynamics-stills": "node scripts/render-videos.cjs --dynamics --stills",
    "site:build": "node scripts/build-site.cjs",
    "site:media": "node scripts/build-site.cjs --media",
    "site:check": "node scripts/check-site.cjs",
    "lesson:check": "node scripts/check-lessons.cjs",
    "narration:check": "node scripts/check-narration.cjs",
    "site:serve": "node scripts/serve-site.cjs"
  },
  "devDependencies": {
    "mathjax-full": "3.2.2",
    "sharp": "0.34.5",
    "svgpath": "2.6.0"
  }
}
